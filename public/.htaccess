# 1. Force LiteSpeed/Apache to prioritize React index.html above any PHP file
DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Enforce HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Redirect direct requests for old WordPress index.php or default.php to /
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /(index|default)\.php[^\ ]*\ HTTP/ [NC]
  RewriteRule ^(index|default)\.php$ / [R=301,L]

  # Don't rewrite real files, directories, or API requests
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-l

  # Route all other URLs to React index.html
  RewriteRule . /index.html [L]
</IfModule>

# Prevent LiteSpeed from caching old PHP responses
<IfModule LiteSpeed>
  CacheLookup off
</IfModule>

# Browser Caching for Assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
</IfModule>
