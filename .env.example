# ==============================================================================
# Yorder Web Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# IMPORTANT SECURITY NOTICE:
# Never commit .env or any file containing live production API keys to git.
# .env is ignored by version control.
# ==============================================================================

# Backend API Configuration
# In local development, Vite proxies /api and /socket.io to VITE_BACKEND_TARGET
VITE_API_URL=/api
VITE_BACKEND_TARGET=https://api.ywsglobal.com
VITE_SOCKET_URL=https://api.ywsglobal.com

# Site & Storage Settings
VITE_SITE_URL=https://yorder.com
VITE_AUTH_TOKEN_KEY=yorder_web_auth_token

# Google Maps JavaScript & Places API Key
# Replace with your restricted Google Cloud API Key
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Razorpay Web Checkout Credentials
# Replace with your public Razorpay Key ID (rzp_test_... for staging, rzp_live_... for production)
VITE_RAZORPAY_KEY_ID=your_razorpay_key_id_here
VITE_RAZORPAY_NAME=Yorder
VITE_BRAND_LOGO_URL=/assets/logo-dark.png
